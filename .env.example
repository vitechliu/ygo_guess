HOST=0.0.0.0
PORT=3131
STORAGE=sqlite
CACHE=file
DATA_DIR=./data
CARD_POOL_PATH=./config/card-pool.json
# Leave empty to disable the special administrator entry.
ADMIN_ENTRY_KEY=
# Set to 1 when serving behind HTTPS in production.
COOKIE_SECURE=0
# Optional extra trusted browser origins (comma-separated).
ALLOWED_ORIGINS=
